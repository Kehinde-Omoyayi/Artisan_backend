# Development-only placeholders. Never copy these values into production.
DJANGO_SETTINGS_MODULE=Artisan_platform.api_settings
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=development-only-change-me-before-deployment
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# Local database and cache. Production requires the configured PostgreSQL/Redis services.
DB_ENGINE=sqlite
REDIS_URL=redis://127.0.0.1:6379/0
USE_S3=false

# Local mail only; this prints verification messages to the console.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Non-live placeholders; provider flows remain unavailable until real API-side credentials are configured securely.
MONO_SECRET_KEY=development-only-placeholder
KYC_ENCRYPTION_KEY=generate-a-local-fernet-key-see-readme
FLW_SECRET_KEY=development-only-placeholder
FLW_PUBLIC_KEY=development-only-placeholder
FLW_SECRET_HASH=development-only-placeholder
FLW_REDIRECT_URL=http://localhost:8000/api/v1/payments/callback
FLW_TRANSFER_CALLBACK_URL=http://localhost:8000/api/v1/payments/transfer
