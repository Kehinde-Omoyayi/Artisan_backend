# ---------------------------------------------------------------------------
# Artisan Market backend - example environment file. Copy to .env and fill in.
# Never commit the filled-in .env. Never paste real secrets into chat, tickets
# or screenshots.
# ---------------------------------------------------------------------------

# --- Core ----------------------------------------------------------------
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=change-me
ALLOWED_HOSTS=api.example.com
CSRF_TRUSTED_ORIGINS=https://market.example.com
SITE_URL=https://market.example.com

# --- Database (production requires PostgreSQL) ----------------------------
DB_ENGINE=postgresql
DB_NAME=artisan
DB_USER=artisan
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# --- Redis / Celery ------------------------------------------------------
REDIS_URL=redis://default-user:@redis.example.com:6379/0
CELERY_BROKER_URL=redis://default-user:@redis.example.com:6379/0
CELERY_RESULT_BACKEND=redis://default-user:@redis.example.com:6379/0
# Publish never blocks a web request; the notifications worker re-offers
# recorded mail every minute until it ships or the code expires.
CELERY_BROKER_CONNECTION_TIMEOUT=1
CELERY_SOCKET_CONNECT_TIMEOUT=1
CELERY_SOCKET_TIMEOUT=2
CELERY_VISIBILITY_TIMEOUT=7200
# NOTIFICATION_REDIS_URL=redis://default-user:@redis.example.com:6379/0

# --- Email (Gmail: implicit SSL, port 465) -------------------------------
# Valid Gmail pair #1 (recommended, used in production today):
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
# Valid Gmail pair #2 (only if 465 is proven blocked on the worker):
# EMAIL_PORT=587
# EMAIL_USE_SSL=False
# EMAIL_USE_TLS=True
EMAIL_HOST_USER=you@gmail.com
# 16-character App Password - never the account password.
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=you@gmail.com
EMAIL_TIMEOUT=10

# Local-only diagnostic: print codes to the API console instead of sending.
# Never set this in production; a code printed in logs is a leaked code.
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# --- Diagnostics ---------------------------------------------------------
# python manage.py check_email
# python manage.py check_email --to you@example.com
