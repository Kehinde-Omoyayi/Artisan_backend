# Copy to .env and customize for your environment. Never commit real secrets.
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=dev-only-change-me-before-deployment

# Browser-facing host/origin settings for the Django frontend.
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# The frontend uses HTTP to reach the separate marketplace API.
ARTISAN_API_BASE_URL=http://127.0.0.1:8000/api/v1
ARTISAN_API_ROOT_URL=http://127.0.0.1:8000
ARTISAN_API_TIMEOUT=20

# Local Django session storage only. Marketplace accounts and records are in the API.
FRONTEND_SESSION_DB=./frontend_sessions.sqlite3

# Secure cookies and HTTPS redirects are enabled automatically in production by default.
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
# Enable only when a trusted reverse proxy strips client-supplied values and sets this header.
TRUST_PROXY_SSL_HEADER=false

LOG_LEVEL=INFO

# Optional Docker Compose overrides; defaults target an API on the host machine.
# FRONTEND_PORT=8001
# DOCKER_ARTISAN_API_BASE_URL=http://host.docker.internal:8000/api/v1
# DOCKER_ARTISAN_API_ROOT_URL=http://host.docker.internal:8000

# Production example: uncomment and replace every domain/value with real settings.
# ENVIRONMENT=production
# DEBUG=false
# SECRET_KEY=generate-a-unique-random-value-at-least-50-characters-long
# ALLOWED_HOSTS=frontend.example.com
# CSRF_TRUSTED_ORIGINS=https://frontend.example.com
# ARTISAN_API_BASE_URL=https://api.example.com/api/v1
# ARTISAN_API_ROOT_URL=https://api.example.com
# SESSION_COOKIE_SECURE=true
# CSRF_COOKIE_SECURE=true
# SECURE_SSL_REDIRECT=true
# SECURE_HSTS_SECONDS=0
